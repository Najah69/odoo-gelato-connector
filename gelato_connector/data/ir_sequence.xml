<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        FIX #13 — company_id is set to False (NULL) to make this a global/shared
        sequence that acts as the fallback for all companies.
        ir.sequence.with_company(id).next_by_code() first looks for a
        company-specific sequence; if none exists it falls back to this global one.
        For production multi-company setups, create a dedicated sequence per company
        via Settings › Technical › Sequences with code "gelato.print.order".
    -->
    <record id="seq_gelato_print_order" model="ir.sequence">
        <field name="name">Gelato Print Order</field>
        <field name="code">gelato.print.order</field>
        <field name="prefix">GPO/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
