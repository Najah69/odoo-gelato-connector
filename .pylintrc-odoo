[MASTER]
load-plugins=pylint_odoo

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
disable=
    # Odoo not installed in lint environment
    import-error,
    # OCA: redundant string= matching auto-generated label
    attribute-string-redundant,
    # **kwargs in route handlers is standard Odoo pattern
    unused-argument,
    # PAGE_SIZE constant naming
    invalid-name,
    # Calling _methods across models is standard Odoo
    protected-access,
    # Docstrings not required on every method
    missing-function-docstring,
    missing-class-docstring,
    missing-module-docstring,
    # Standard OCA patterns
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    # OCA author check (not an official OCA repo)
    manifest-required-author,
    # Catching broad Exception in background tasks is intentional
    broad-exception-caught,
